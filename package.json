{
  "name": "prisma-x",
  "version": "0.1.0",
  "private": true,
  "description": "Generate code for other languages and ORMs (Diesel, SQLAlchemy) from Prisma schemas, built on @prisma/prisma-schema-wasm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prismax": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/diesel": {
      "types": "./dist/adapters/diesel/index.d.ts",
      "import": "./dist/adapters/diesel/index.js"
    },
    "./adapters/sqlalchemy": {
      "types": "./dist/adapters/sqlalchemy/index.d.ts",
      "import": "./dist/adapters/sqlalchemy/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python3 -m pytest scripts/tests -q",
    "compile-check": "pnpm build && python3 scripts/compile_check_diesel.py",
    "check:sqlalchemy": "pnpm build && python3 scripts/check_sqlalchemy_models.py"
  },
  "dependencies": {
    "@prisma/prisma-schema-wasm": "8.1.0-2.59be4fda12412a79eeb9c2ae727b6aa723593323"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.3",
    "vitest": "4.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
