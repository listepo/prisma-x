datasource db {
  provider = "postgresql"
}

model Place {
  id       Int                     @id @default(autoincrement())
  name     String
  location Unsupported("point")?
  area     Unsupported("polygon")? @map("area_poly")
  ip       String?                 @db.Inet
  doc      String?                 @db.Xml
  flags    String?                 @db.Bit(8)
  tags     String[]
}

/// No @id: identified by a unique email.
model Contact {
  email String @unique
  name  String
}
